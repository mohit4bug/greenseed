{
	"name": "greenseed",
	"version": "0.1.0-beta.0",
	"keywords": [
		"database",
		"idempotent",
		"seed"
	],
	"license": "MIT",
	"author": "Mohit Khatri",
	"bin": {
		"greenseed": "dist/cli.cjs"
	},
	"files": [
		"dist"
	],
	"type": "module",
	"main": "./dist/index.js",
	"module": "./dist/index.js",
	"types": "./dist/index.d.ts",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js",
			"require": "./dist/index.cjs"
		},
		"./package.json": "./package.json"
	},
	"scripts": {
		"build": "tsup",
		"dev": "tsup --watch",
		"typecheck": "tsc --noEmit",
		"clean": "rm -rf dist",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"lint:check": "oxlint",
		"format": "oxfmt",
		"format:check": "oxfmt --check",
		"check": "oxlint && oxfmt --check && tsc --noEmit",
		"prepublishOnly": "pnpm run check && pnpm run build",
		"release": "pnpm run check && pnpm run build && npm publish --tag beta && git push --follow-tags",
		"prepare": "husky"
	},
	"dependencies": {
		"dotenv": "17.2.3",
		"postgres": "3.4.7",
		"sade": "1.8.1",
		"valibot": "1.2.0"
	},
	"devDependencies": {
		"@types/node": "24.10.4",
		"@valibot/to-json-schema": "1.5.0",
		"husky": "9.1.7",
		"oxfmt": "0.55.0",
		"oxlint": "1.70.0",
		"tsup": "8.5.1",
		"typescript": "5.9.3"
	}
}
