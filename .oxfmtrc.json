{
	"$schema": "./node_modules/oxfmt/configuration_schema.json",
	"semi": false,
	"useTabs": true,
	"singleQuote": false,
	"trailingComma": "all",
	"printWidth": 100,
	"bracketSpacing": true,
	"arrowParens": "always",
	"endOfLine": "lf",
	"sortImports": true,
	"ignorePatterns": ["dist/**", "node_modules/**"]
}
